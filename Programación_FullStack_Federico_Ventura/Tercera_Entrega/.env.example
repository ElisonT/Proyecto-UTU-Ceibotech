# Copiar este archivo como .env para cambiar los valores por defecto (el .env no se sube a git).
# Si no existe .env, docker compose usa los valores de desarrollo que están en docker-compose.yml.

# Puerto donde se publica el sitio (en un servidor suele ser 80).
WEB_PORT=8080

# Contraseña del usuario de la aplicación y del administrador de MariaDB.
# Ojo: se aplican la PRIMERA vez que se crea la base. Si ya existe el volumen, para cambiarlas
# hay que borrarlo (docker compose down -v) o cambiarlas dentro de MariaDB.
SGDM_DB_USER=sgdm_app
SGDM_DB_PASS=cambiar_esta_clave
SGDM_DB_ROOT_PASS=cambiar_esta_otra_clave

# 1 = cargar los datos de prueba (usuarios test_*, torneos, equipos...). 0 = base vacía.
CARGAR_DATOS_PRUEBA=1
